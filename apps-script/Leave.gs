Notified:true,pksContact:'ຫ້ອງການ ປກສ ເມືອງຄອບ',submittedAt:T+'T09:02',status:'pending'})\n  ];\n  recs.sort((a,b)=>a.submittedAt.localeCompare(b.submittedAt));\n  const prevOff=state.officers;state.officers=officers;\n  recs.forEach(r=>{\n    r.no=lvNextNo_(store,r.submittedAt);\n    if(r.status!=='pending')r.decision={result:r.status==='rejected'?'rejected':'approved',by:HEAD,at:r.decidedAt,comment:r.comment||approveText(r)};\n    r.late=lvLate_(r);\n    delete r.decidedAt;delete r.comment;\n    store.records.push(r);\n  });\n  state.officers=prevOff;\n  return store;\n}\n\n/* ---------- state: data from Google Sheet + this device's preferences ---------- */\nconst PREF_KEY='ldb-khop-leave-prefs-v1',TOK_KEY='ldb-khop-leave-tok';\nconst IS_GAS=!!(window.google&&google.script&&google.script.run);\nlet BASE_URL=(document.getElementById('cfg')||{dataset:{}}).dataset.base||'';\nif(!/^https:/.test(BASE_URL))BASE_URL='https://script.google.com/macros/s/AKfycbyHycdbHn73ir_ZKXQXpm2puN6zX1drI-zUHHw_LYCuIS9mJOiUd--JrBPM8ox9_jRsTQ/exec';\nconst SHEET_URL='https://docs.google.com/spreadsheets/d/1P-q_IduI3M1tsbF0l4zLtPc4XySPgcnOr5hJB9vEL-g/edit#gid=7100001';\nfunction loadPrefs(){try{const p=JSON.parse(localStorage.getItem(PREF_KEY));if(p&&p.tab)return p;}catch(e){}return {chosen:false,role:'officer',me:'',tab:{officer:'home',head:'home'}};}\nconst prefs=loadPrefs();\nlet state={officers:[],photos:{},settings:{unitPhone:'',passIsDefault:false},records:[],role:prefs.role,me:prefs.me,tab:prefs.tab};\nfunction save(){prefs.role=state.role;prefs.me=state.me;prefs.tab=state.tab;try{localStorage.setItem(PREF_KEY,JSON.stringify(prefs));}catch(e){}}\nconst ui={newPhoto:'',phoneOpen:false,month:null,headAuthed:false,confirmDel:null,loaded:false,loadErr:'',busy:0,att:null,mineRange:'year'};\ntry{ui.token=sessionStorage.getItem(TOK_KEY)||'';}catch(e){ui.token='';}\nconst pendUI={};\nfunction ensureMe(){if(!actives().find(o=>String(o.id)===String(state.me))){const a=actives()[0];state.me=a?a.id:'';}}\n\n/* ---------- server calls ---------- */\nconst demo={store:null,pass:'1234',toks:{},att:{}};\nfunction demoAtt(){\n  const T=today(),s=demo.store;\n  return {date:T,rate:50000,items:s.officers.filter(o=>o.active).map(o=>{const k=o.id;demo.att[k]=demo.att[k]||{month:7};const p=!!demo.att[k][T];return {id:String(o.id),name:(o.rank?o.rank+' ':'')+o.name,present:p,month:demo.att[k].month+(p?1:0),money:(demo.att[k].month+(p?1:0))*50000};})};\n}\nfunction demoCall(req){\n  return new Promise(res=>setTimeout(()=>{\n    try{\n      if(!demo.store)demo.store=seedDemo();\n      const a=req.action,d=req.data||{};let authed=!!demo.toks[req.token];const out={ok:true};\n      if(a==='login'){if(d.pass!==demo.pass){res({ok:false,err:'ລະຫັດບໍ່ຖືກຕ້ອງ. ລອງໃໝ່ອີກຄັ້ງ.'});return;}const t='t'+Math.random().toString(36).slice(2);demo.toks[t]=1;out.token=t;authed=true;}\n      else if(a==='logout'){delete demo.toks[req.token];authed=false;}\n      else if(a==='attCheckin'){const k=d.id;demo.att[k]=demo.att[k]||{month:7};out.already=!!demo.att[k][today()];demo.att[k][today()]=1;out.att=demoAtt();res(JSON.parse(JSON.stringify(out)));return;}\n      else if(a!=='load'){\n        if(a==='settingsSave'&&d.pass){if(!authed)throw new Error('AUTH');if(String(d.pass).length<4)throw new Error('ລະຫັດຕ້ອງມີຢ່າງໜ້ອຍ 4 ຕົວ');demo.pass=d.pass;}\n        out.id=leaveCore_(demo.store,a,d,nowL(),authed).id;\n      }\n      const s=demo.store;\n      out.data={officers:s.officers,photos:s.photos||{},settings:{unitPhone:s.settings.unitPhone||'',passIsDefault:demo.pass==='1234'},records:s.records,authed:authed};\n      if(a==='load')out.att=demoAtt();\n      res(JSON.parse(JSON.stringify(out)));\n    }catch(e){res({ok:false,err:String(e&&e.message||e)});}\n  },200));\n}\nfunction gasCall(req){\n  return new Promise((res,rej)=>google.script.run.withSuccessHandler(s=>{try{res(JSON.parse(s));}catch(e){rej(e);}}).withFailureHandler(rej).leaveApi(JSON.stringify(req)));\n}\nfunction setBusy(d){ui.busy=Math.max(0,ui.busy+d);$('#busy').hidden=!ui.busy;const b=$('#refresh');if(b)b.classList.toggle('spin',!!ui.busy);}\nfunction setToken(t){ui.token=t||'';ui.headAuthed=!!t;try{t?sessionStorage.setItem(TOK_KEY,t):sessionStorage.removeItem(TOK_KEY);}catch(e){}}\nfunction applyData(d){\n  if(!d)return;\n  state.officers=d.officers||[];state.photos=d.photos||{};state.settings=d.settings||{};state.records=d.records||[];\n  if(!d.authed&&ui.token)setToken('');\n  ui.headAuthed=!!d.authed;ui.loaded=true;ui.loadErr='';\n}\nfunction api(action,data,btn){\n  setBusy(1);if(btn)btn.disabled=true;\n  return (IS_GAS?gasCall:demoCall)({action:action,data:data||{},token:ui.token}).then(res=>{\n    setBusy(-1);if(btn)btn.disabled=false;\n    if(!res.ok){\n      if(res.err==='AUTH'){setToken('');render();throw new Error('ໝົດເວລາເຂົ້າລະບົບ: ກະລຸນາເຂົ້າສູ່ລະບົບໃໝ່');}\n      throw new Error(res.err||'ເກີດຂໍ້ຜິດພາດ');\n    }\n    if(res.token)setToken(res.token);\n    applyData(res.data);\n    return res;\n  },e=>{setBusy(-1);if(btn)btn.disabled=false;throw new Error('ເຊື່ອມຕໍ່ເຊີບເວີບໍ່ໄດ້: ກວດອິນເຕີເນັດແລ້ວລອງໃໝ່');});\n}\nfunction fail(e,msgEl){const t=e&&e.message||String(e);if(msgEl){msgEl.textContent=t;msgEl.className='form-msg bad';}toast(t);}\nfunction refresh(quiet){\n  return api('load').then(res=>{ui.att=res.att||{err:'OLD'};render();if(!quiet)toast('ອັບເດດຂໍ້ມູນແລ້ວ');}).catch(e=>{if(!ui.loaded){ui.loadErr=e.message;render();}else toast(e.message);});\n}\nfunction newDraft(){\n  const o=off(state.me),h=actives().find(x=>x.id!==o.id);\n  return {officerId:o.id,type:'ລ2',startDate:addDays(today(),1),endDate:addDays(today(),2),timeFrom:'09:00',timeTo:'10:00',reason:'',reasonOther:'',orderNo:'',detail:'',destination:'',phone:o.phone||'',emergencyName:'',emergencyPhone:'',attachMed:false,attachOrder:false,filing:'advance',callTime:'',callTo:'ຫົວໜ້າໜ່ວຍບໍລິການ',handoverTo:h?h.id:'',pksReplacement:'',pksNotified:false,pksContact:'',pledge:false,linkId:null};\n}\nlet draft=null;\nfunction draftRec(){\n  const t=TYPES[draft.type];\n  const r=Object.assign({},draft,{id:draft.linkId||'__draft',submittedAt:nowL()});\n  if(t.kind!=='range')r.endDate=r.startDate;\n  if(t.kind==='fixed'){r.timeFrom=t.from;r.timeTo=t.to;}\n  if(t.kind==='day'||t.kind==='range'){r.timeFrom='';r.timeTo='';}\n  return r;\n}\n\n/* ---------- small renderers ---------- */\nconst pill=r=>'<span class=\"pill '+STATUS[r.status].c+'\">'+STATUS[r.status].t+(r.status==='returned'&&r.late>0.01?' · ຊ້າ '+fmtH(r.late):'')+(r.status==='phone'&&r.returnedAt?' · ກັບແລ້ວ':'')+'</span>';\nconst empty=t=>'<p class=\"empty\">'+t+'</p>';\nfunction itemRow(r,showName){\n  return '<li><button class=\"row-btn\" type=\"button\" data-act=\"detail\" data-id=\"'+r.id+'\"><span class=\"r-main\"><span class=\"r-top\"><span class=\"no\">'+(r.no||'ຍັງບໍ່ມີເລກທີ')+'</span>'+pill(r)+'</span><span class=\"r-title\">'+(showName?esc(full(off(r.officerId)))+' · ':'')+'<b>'+r.type+'</b> '+TYPES[r.type].label+'</span><span class=\"r-sub\">'+esc(period(r))+' · '+esc(reasonText(r))+'</span></span><span class=\"chev\" aria-hidden=\"true\">›</span></button>'+(canSelfReturn(r)?'<div class=\"li-act\"><button class=\"btn primary sm\" type=\"button\" data-act=\"self-return\" data-id=\"'+r.id+'\">ກັບຄືນ</button><span class=\"r-sub\">ກົດເມື່ອກັບມາຮອດຈຸດປະຈຳການ · ກຳນົດກັບ '+fDate(expRet(r))+'</span></div>':'')+'</li>';\n}\nfunction dueText(r){\n  const d=r.phoneLog.deadline,over=new Date()>new Date(d);\n  return '<span class=\"due'+(over?' over':'')+'\">'+(over?'ເກີນກຳນົດຍື່ນໃບລາ: ':'ຕ້ອງຍື່ນໃບລາຍ້ອນຫຼັງກ່ອນ ')+fDT(d)+'</span>';\n}\nconst canSelfReturn=r=>state.role==='officer'&&String(r.officerId)===String(state.me)&&!r.returnedAt&&((r.status==='approved'&&new Date()>=span(r)[0])||r.status==='phone');\nconst unacked=()=>state.records.filter(r=>r.returnBy==='self'&&r.returnAck===false);\n\n/* ---------- officer views ---------- */\nfunction officerNew(){\n  const o=off(state.me),d=draft;\n  const link=d.linkId?get(d.linkId):null;\n  const others=actives().filter(x=>x.id!==o.id);\n  return '<form id=\"lf\" class=\"card form\" novalidate>'+\n  '<div class=\"card-head\"><h2>ຂຽນໃບຂໍລາພັກ</h2><p class=\"muted\">ຜູ້ຂໍລາ: <b>'+esc(full(o))+'</b> · ປກສ ເມືອງຄອບ</p></div>'+\n  (link?'<div class=\"note\">ຍື່ນຍ້ອນຫຼັງ ສຳລັບການແຈ້ງທາງໂທ ວັນທີ '+fD(link.startDate)+' ເວລາ '+esc(link.callTime)+' · '+dueText(link)+'</div>':'')+\n  '<fieldset class=\"field\"><legend>ປະເພດການລາ</legend><div class=\"types\">'+Object.keys(TYPES).map(k=>{const t=TYPES[k];return '<label class=\"type\"><input type=\"radio\" name=\"type\" value=\"'+k+'\"'+(d.type===k?' checked':'')+'><span class=\"code\">'+k+'</span><span class=\"tl\">'+t.label+'</span><span class=\"tn\">'+t.note+'</span></label>';}).join('')+'</div></fieldset>'+\n  '<div class=\"row\">'+\n    '<div class=\"field\"><label for=\"f-start\" id=\"l-start\">ວັນທີ</label><input type=\"date\" id=\"f-start\" name=\"startDate\" value=\"'+d.startDate+'\"></div>'+\n    '<div class=\"field\" data-show=\"range\"><label for=\"f-end\">ຫາວັນທີ</label><input type=\"date\" id=\"f-end\" name=\"endDate\" value=\"'+d.endDate+'\"></div>'+\n    '<div class=\"field\" data-show=\"time\"><label for=\"f-tf\">ເວລາອອກ</label><input type=\"time\" id=\"f-tf\" name=\"timeFrom\" value=\"'+d.timeFrom+'\"></div>'+\n    '<div class=\"field\" data-show=\"time\"><label for=\"f-tt\">ເວລາກັບ</label><input type=\"time\" id=\"f-tt\" name=\"timeTo\" value=\"'+d.timeTo+'\"></div>'+\n  '</div>'+\n  '<p class=\"period\" id=\"f-period\"></p>'+\n  '<fieldset class=\"field\"><legend>ເຫດຜົນ</legend><div class=\"chips\">'+REASONS.map(x=>'<label class=\"chip\"><input type=\"radio\" name=\"reason\" value=\"'+x+'\"'+(d.reason===x?' checked':'')+'><span>'+x+'</span></label>').join('')+'</div></fieldset>'+\n  '<div class=\"field\" data-show=\"reasonOther\"><label for=\"f-ro\">ລະບຸເຫດຜົນ</label><input id=\"f-ro\" name=\"reasonOther\" value=\"'+esc(d.reasonOther)+'\"></div>'+\n  '<div class=\"field\" data-show=\"order\"><label for=\"f-order\">ເລກທີຄຳສັ່ງ ປກສ</label><input id=\"f-order\" name=\"orderNo\" placeholder=\"ເຊັ່ນ 112/ປກສ.ຄອບ\" value=\"'+esc(d.orderNo)+'\"></div>'+\n  '<div class=\"field\"><label for=\"f-detail\">ລາຍລະອຽດເຫດຜົນ</label><textarea id=\"f-detail\" name=\"detail\" rows=\"2\">'+esc(d.detail)+'</textarea></div>'+\n  '<div class=\"row\">'+\n    '<div class=\"field\"><label for=\"f-dest\">ສະຖານທີ່ທີ່ຈະໄປ</label><input id=\"f-dest\" name=\"destination\" value=\"'+esc(d.destination)+'\"></div>'+\n    '<div class=\"field\"><label for=\"f-phone\">ເບີໂທຕິດຕໍ່ໃນເວລາລາ</label><input id=\"f-phone\" name=\"phone\" inputmode=\"tel\" value=\"'+esc(d.phone)+'\"></div>'+\n  '</div>'+\n  '<fieldset class=\"field\" data-show=\"emerg\"><legend>ຕິດຕໍ່ສຸກເສີນ (ກໍລະນີໂທຫາຜູ້ລາບໍ່ໄດ້)</legend><div class=\"row\">'+\n    '<div class=\"field\"><label for=\"f-en\" class=\"sub-label\">ຊື່ ແລະ ຄວາມສຳພັນ</label><input id=\"f-en\" name=\"emergencyName\" placeholder=\"ເຊັ່ນ ພັນລະຍາ, ພໍ່, ແມ່\" value=\"'+esc(d.emergencyName)+'\"></div>'+\n    '<div class=\"field\"><label for=\"f-ep\" class=\"sub-label\">ເບີໂທສຸກເສີນ</label><input id=\"f-ep\" name=\"emergencyPhone\" inputmode=\"tel\" value=\"'+esc(d.emergencyPhone)+'\"></div>'+\n  '</div></fieldset>'+\n  '<fieldset class=\"field\"><legend>ເອກະສານຕິດຄັດ</legend><div class=\"chips\"><label class=\"chip\"><input type=\"checkbox\" id=\"f-med\" name=\"attachMed\"'+(d.attachMed?' checked':'')+'><span>ໃບຢັ້ງຢືນແພດ</span></label><label class=\"chip\"><input type=\"checkbox\" id=\"f-ord\" name=\"attachOrder\"'+(d.attachOrder?' checked':'')+'><span>ຄຳສັ່ງ ປກສ</span></label></div></fieldset>'+\n  '<fieldset class=\"field\"><legend>ການຍື່ນ</legend><div class=\"chips\"><label class=\"chip\"><input type=\"radio\" name=\"filing\" value=\"advance\"'+(d.filing==='advance'?' checked':'')+(link?' disabled':'')+'><span>ຍື່ນລ່ວງໜ້າ</span></label><label class=\"chip\"><input type=\"radio\" name=\"filing\" value=\"retro\"'+(d.filing==='retro'?' checked':'')+(link?' disabled':'')+'><span>ຍື່ນຍ້ອນຫຼັງ (ສຸກເສີນ)</span></label></div></fieldset>'+\n  '<div class=\"row\" data-show=\"retro\">'+\n    '<div class=\"field\"><label for=\"f-ct\">ເວລາໂທແຈ້ງ</label><input type=\"time\" id=\"f-ct\" name=\"callTime\" value=\"'+esc(d.callTime)+'\"></div>'+\n    '<div class=\"field\"><label for=\"f-cto\">ໂທແຈ້ງຫາ</label><input id=\"f-cto\" name=\"callTo\" value=\"'+esc(d.callTo)+'\"></div>'+\n  '</div>'+\n  '<fieldset class=\"field\"><legend>ການມອບໜ້າທີ່</legend><div class=\"row\">'+\n    '<div class=\"field\"><label for=\"f-ho\" class=\"sub-label\">ຜູ້ຮັບມອບໜ້າທີ່ (ຢູ່ປະຈຳການ)</label><select id=\"f-ho\" name=\"handoverTo\">'+(others.length?others.map(x=>'<option value=\"'+x.id+'\"'+(x.id===d.handoverTo?' selected':'')+'>'+esc(full(x))+'</option>').join(''):'<option value=\"\">ບໍ່ມີເຈົ້າໜ້າທີ່ອື່ນ</option>')+'</select></div>'+\n    '<div class=\"field\"><label for=\"f-rep\" class=\"sub-label\">ຜູ້ມາແທນຈາກ ປກສ (ຖ້າມີ)</label><input id=\"f-rep\" name=\"pksReplacement\" value=\"'+esc(d.pksReplacement)+'\" placeholder=\"ຍົດ, ຊື່ ແລະ ນາມສະກຸນ\"></div>'+\n  '</div></fieldset>'+\n  '<div class=\"field\" data-show=\"pks\"><label class=\"check\" for=\"f-pksn\"><input type=\"checkbox\" id=\"f-pksn\" name=\"pksNotified\"'+(d.pksNotified?' checked':'')+'><span>ແຈ້ງ ປກສ ເມືອງຄອບແລ້ວ</span></label><input id=\"f-pkc\" name=\"pksContact\" placeholder=\"ຜູ້ຮັບແຈ້ງ ແລະ ເບີໂທ\" value=\"'+esc(d.pksContact)+'\"></div>'+\n  '<div class=\"checks-box\"><h3>ກວດຕາມລະບຽບ (ອັດຕະໂນມັດ)</h3><ul class=\"checks\" id=\"f-checks\"></ul></div>'+\n  '<label class=\"check pledge\" for=\"f-pledge\"><input type=\"checkbox\" id=\"f-pledge\" name=\"pledge\"'+(d.pledge?' checked':'')+'><span>ຂ້າພະເຈົ້າຂໍຢັ້ງຢືນວ່າ ຂໍ້ມູນຂ້າງເທິງເປັນຄວາມຈິງ ແລະ ຈະກັບມາປະຈຳການຕາມກຳນົດ. ຖ້າກັບຊ້າ ຫຼື ບໍ່ຍື່ນໃບລາຕາມລະບຽບ ຍິນດີໃຫ້ນັບເປັນ \"ຂາດ\".</span></label>'+\n  '<div class=\"actions\"><button type=\"submit\" class=\"btn primary\" id=\"f-submit\">ສົ່ງໃບລາໃຫ້ຫົວໜ້າອະນຸມັດ</button><p class=\"form-msg\" id=\"f-msg\" role=\"status\"></p></div>'+\n  '</form>';\n}\nfunction dyn(){\n  const f=$('#lf');if(!f)return;\n  const t=TYPES[draft.type];\n  const show={range:t.kind==='range',time:t.kind==='time',reasonOther:draft.reason==='ອື່ນໆ',order:draft.type==='ໜທ'||draft.reason==='ວຽກ ປກສ',retro:draft.filing==='retro',pks:!!t.pks,emerg:draft.type!=='ອຊ'};\n  f.querySelectorAll('[data-show]').forEach(el=>{el.hidden=!show[el.dataset.show];});\n  $('#l-start').textContent=t.kind==='range'?'ແຕ່ວັນທີ':'ວັນທີ';\n  const r=draftRec();\n  $('#f-period').innerHTML='<b>'+esc(period(r))+'</b> · '+qtyText(r);\n  $('#f-checks').innerHTML=checksHTML(checks(r));\n}\n\n/* ---------- head views ---------- */\nfunction loginView(){\n  return '<section class=\"card login\"><div class=\"card-head\"><h2>ເຂົ້າສູ່ລະບົບ ຫົວໜ້າໜ່ວຍບໍລິການ</h2><p class=\"muted\">ພິມລະຫັດ admin ເພື່ອກວດ ແລະ ອະນຸມັດໃບລາ</p></div>'+\n  '<form id=\"login\" class=\"form\" novalidate><div class=\"field\"><label for=\"lg-pass\">ລະຫັດ admin</label><input id=\"lg-pass\" type=\"password\" autocomplete=\"current-password\"></div>'+\n  '<p class=\"form-msg\" id=\"lg-msg\" role=\"status\"></p><div class=\"actions\"><button class=\"btn primary\" type=\"submit\">ເຂົ້າສູ່ລະບົບ</button></div>'+\n  (state.settings.passIsDefault?'<p class=\"how\">ລະຫັດເລີ່ມຕົ້ນແມ່ນ <b>1234</b>. ກະລຸນາປ່ຽນໃນແຖບ ຕັ້ງຄ່າ ຫຼັງເຂົ້າລະບົບ.</p>':'')+'</form></section>';\n}\nfunction approveCard(r){\n  const o=off(r.officerId),cs=checks(r),u=pendUI[r.id]||{};\n  return '<article class=\"card ap\" id=\"ap-'+r.id+'\">'+\n  '<header class=\"ap-head\"><div><span class=\"no\">'+r.no+'</span> '+(r.filing==='retro'?'<span class=\"pill warn\">ຍື່ນຍ້ອນຫຼັງ</span>':'')+'<h3>'+esc(full(o))+'</h3><p class=\"ap-type\"><b>'+r.type+'</b> '+TYPES[r.type].label+' · '+esc(period(r))+' · '+qtyText(r)+'</p></div><button class=\"btn ghost sm\" type=\"button\" data-act=\"detail\" data-id=\"'+r.id+'\">ເບິ່ງໃບລາ</button></header>'+\n  '<dl class=\"kv\"><div><dt>ເຫດຜົນ</dt><dd>'+esc(reasonText(r))+(r.orderNo?' · ຄຳສັ່ງ '+esc(r.orderNo):'')+(r.detail?'<br><span class=\"muted\">'+esc(r.detail)+'</span>':'')+'</dd></div><div><dt>ສະຖານທີ່</dt><dd>'+esc(r.destination)+'</dd></div><div><dt>ເບີຕິດຕໍ່</dt><dd>'+esc(r.phone)+'</dd></div><div><dt>ຕິດຕໍ່ສຸກເສີນ</dt><dd>'+(r.emergencyPhone?esc(r.emergencyName)+' · '+esc(r.emergencyPhone):'—')+'</dd></div><div><dt>ຍື່ນເມື່ອ</dt><dd>'+fDT(r.submittedAt)+'</dd></div></dl>'+\n  '<ul class=\"checks\">'+checksHTML(cs)+'</ul>'+\n  '<div class=\"field\"><label for=\"cm-'+r.id+'\">ຄຳເຫັນຂອງຫົວໜ້າ (ແກ້ໄຂໄດ້)</label><textarea id=\"cm-'+r.id+'\" rows=\"4\">'+esc(u.comment!=null?u.comment:approveText(r))+'</textarea></div>'+\n  '<div class=\"field\"><label for=\"by-'+r.id+'\">ຜູ້ອະນຸມັດ</label><input id=\"by-'+r.id+'\" value=\"'+esc(u.by!=null?u.by:HEAD)+'\"></div>'+\n  '<p class=\"form-msg\" id=\"am-'+r.id+'\" role=\"status\"></p>'+\n  '<div class=\"actions\"><button class=\"btn primary\" type=\"button\" data-act=\"approve\" data-id=\"'+r.id+'\">ອະນຸມັດ</button><button class=\"btn danger\" type=\"button\" data-act=\"reject\" data-id=\"'+r.id+'\">ບໍ່ອະນຸມັດ</button></div></article>';\n}\nfunction headApprove(){\n  const p=state.records.filter(r=>r.status==='pending').sort((a,b)=>a.startDate.localeCompare(b.startDate));\n  const ua=unacked().length;\n  return (ua?'<div class=\"note\" style=\"background:var(--accent-soft)\">ມີ '+ua+' ການແຈ້ງກັບມາປະຈຳການ ລໍຖ້າຮັບຊາບ · <button class=\"link\" type=\"button\" data-act=\"tab\" data-id=\"track\">ໄປທີ່ແຖບ ຕິດຕາມ</button></div>':'')+'<p class=\"how\">ກວດຕາມລະບຽບໃຫ້ແລ້ວ: <b>✓</b> ຖືກຕ້ອງ, <b>!</b> ຄວນພິຈາລະນາ, <b>✕</b> ບໍ່ຖືກລະບຽບ. ຫຼັງອະນຸມັດ ຫຼື ບໍ່ອະນຸມັດ ສົ່ງອອກໃບລາເປັນຮູບພາບ ເພື່ອແຈ້ງໃນກຸ່ມໄດ້.</p>'+\n  (p.length?p.map(approveCard).join(''):'<div class=\"card\">'+empty('ບໍ່ມີໃບລາລໍຖ້າອະນຸມັດ')+'</div>');\n}\nfunction phoneForm(){\n  if(!ui.phoneOpen)return '';\n  const n=nowL().slice(11);\n  return '<div class=\"subform\" id=\"pf\">'+\n  '<div class=\"row\"><div class=\"field\"><label for=\"pf-o\">ຕຳຫຼວດ</label><select id=\"pf-o\">'+actives().map(o=>'<option value=\"'+o.id+'\">'+esc(full(o))+'</option>').join('')+'</select></div>'+\n  '<div class=\"field\"><label for=\"pf-t\">ປະເພດ</label><select id=\"pf-t\">'+['ອຊ','ລ1','ລ2','ລ3'].map(k=>'<option value=\"'+k+'\"'+(k==='ລ1'?' selected':'')+'>'+k+' '+TYPES[k].label+'</option>').join('')+'</select></div>'+\n  '<div class=\"field\"><label for=\"pf-d\">ວັນທີ</label><input type=\"date\" id=\"pf-d\" value=\"'+today()+'\"></div></div>'+\n  '<div class=\"row pf-time\" hidden><div class=\"field\"><label for=\"pf-tf\">ເວລາອອກ</label><input type=\"time\" id=\"pf-tf\" value=\"'+n+'\"></div><div class=\"field\"><label for=\"pf-tt\">ເວລາກັບ (ຄາດວ່າ)</label><input type=\"time\" id=\"pf-tt\"></div></div>'+\n  '<div class=\"row\"><div class=\"field\"><label for=\"pf-ct\">ເວລາໂທແຈ້ງ</label><input type=\"time\" id=\"pf-ct\" value=\"'+n+'\"></div><div class=\"field\"><label for=\"pf-by\">ຜູ້ຮັບແຈ້ງ</label><input id=\"pf-by\" value=\"ຫົວໜ້າໜ່ວຍບໍລິການ\"></div></div>'+\n  '<div class=\"field\"><label for=\"pf-note\">ເຫດຜົນໂດຍຫຍໍ້</label><input id=\"pf-note\" placeholder=\"ເຊັ່ນ ລົດເພ້ກາງທາງ\"></div>'+\n  '<p class=\"form-msg\" id=\"pf-msg\" role=\"status\"></p>'+\n  '<div class=\"actions\"><button class=\"btn primary\" type=\"button\" data-act=\"phone-save\">ບັນທຶກການແຈ້ງ</button><button class=\"btn ghost\" type=\"button\" data-act=\"phone-cancel\">ຍົກເລີກ</button></div></div>';\n}\nfunction phoneRow(r){\n  const over=new Date()>new Date(r.phoneLog.deadline);\n  return '<li class=\"trk\"><div class=\"trk-top\"><span class=\"trk-title\"><b>'+esc(full(off(r.officerId)))+'</b> · '+r.type+' '+TYPES[r.type].label+'</span>'+pill(r)+'</div>'+\n  '<span class=\"trk-sub\">'+esc(period(r))+' · ໂທແຈ້ງ '+esc(r.phoneLog.by)+' ເວລາ '+esc(r.callTime)+(r.detail?' · '+esc(r.detail):'')+'</span>'+(r.returnedAt?'<span class=\"trk-sub\">ກັບມາແລ້ວ <b>'+fDT(r.returnedAt)+'</b></span>':'')+dueText(r)+\n  '<div class=\"actions\">'+(over?'<button class=\"btn danger sm\" type=\"button\" data-act=\"absent\" data-id=\"'+r.id+'\">ໝາຍເປັນ \"ຂາດ\"</button>':'')+'<button class=\"btn ghost sm\" type=\"button\" data-act=\"detail\" data-id=\"'+r.id+'\">ເບິ່ງລາຍລະອຽດ</button></div></li>';\n}\nfunction trackRow(r){\n  const now=new Date(),s=span(r)[0],er=expRet(r);\n  const st=now<s?['ຈະລາ','accent']:(now<=er?['ກຳລັງລາ','warn']:['ເກີນກຳນົດກັບ','bad']);\n  return '<li class=\"trk\"><div class=\"trk-top\"><span class=\"trk-title\"><span class=\"no\">'+r.no+'</span> <b>'+esc(full(off(r.officerId)))+'</b> · '+r.type+' '+TYPES[r.type].label+'</span><span class=\"pill '+st[1]+'\">'+st[0]+'</span></div>'+\n  '<span class=\"trk-sub\">'+esc(period(r))+' · ກຳນົດກັບ '+fDate(er)+' · ໂທ '+esc(r.phone)+'</span>'+\n  (now>=s?'<div class=\"ret\"><label class=\"sub-label\" for=\"ret-'+r.id+'\" style=\"margin:0\">ກັບມາເວລາ</label><input type=\"datetime-local\" id=\"ret-'+r.id+'\" value=\"'+nowL()+'\"><button class=\"btn primary sm\" type=\"button\" data-act=\"ret-save\" data-id=\"'+r.id+'\">ບັນທຶກກັບຄືນ</button></div>':'')+\n  '</li>';\n}\nfunction ackSection(){\n  const l=unacked().sort((a,b)=>b.returnedAt.localeCompare(a.returnedAt));\n  if(!l.length)return '';\n  return '<section class=\"card\" style=\"border-color:var(--accent)\"><div class=\"card-head\"><h2>ແຈ້ງກັບມາປະຈຳການ ('+l.length+')</h2><p class=\"muted\">ຕຳຫຼວດກົດ \"ກັບຄືນ\" ດ້ວຍຕົນເອງ · ກົດ ຮັບຊາບ ເມື່ອກວດແລ້ວ</p></div><ul class=\"list\">'+\n  l.map(r=>'<li class=\"trk\"><div class=\"trk-top\"><span class=\"trk-title\"><span class=\"no\">'+(r.no||'ແຈ້ງທາງໂທ')+'</span> <b>'+esc(full(off(r.officerId)))+'</b> · '+r.type+' '+TYPES[r.type].label+'</span><span class=\"pill '+(r.late>0.01?'bad':'good')+'\">'+(r.late>0.01?'ກັບຊ້າ '+fmtH(r.late):'ກັບຕາມກຳນົດ')+'</span></div>'+\n    '<span class=\"trk-sub\">ກັບມາ <b>'+fDT(r.returnedAt)+'</b> · ກຳນົດກັບ '+fDate(expRet(r))+' · '+esc(period(r))+'</span>'+\n    '<div class=\"actions\"><button class=\"btn primary sm\" type=\"button\" data-act=\"ack\" data-id=\"'+r.id+'\">ຮັບຊາບ</button><button class=\"btn ghost sm\" type=\"button\" data-act=\"detail\" data-id=\"'+r.id+'\">ເບິ່ງໃບລາ</button></div></li>').join('')+'</ul></section>';\n}\nfunction headTrack(){\n  const ph=state.records.filter(r=>r.status==='phone');\n  const ap=state.records.filter(r=>r.status==='approved').sort((a,b)=>span(a)[0]-span(b)[0]);\n  return ackSection()+'<section class=\"card\"><div class=\"card-head row-between\"><div><h2>ແຈ້ງລາທາງໂທລະສັບ</h2><p class=\"muted\">ສຸກເສີນ: ບັນທຶກທັນທີ ແລ້ວລໍຖ້າໃບລາຍ້ອນຫຼັງພາຍໃນ 1 ວັນ</p></div><button class=\"btn ghost sm\" type=\"button\" data-act=\"phone-open\">'+(ui.phoneOpen?'ປິດແບບຟອມ':'+ ບັນທຶກການແຈ້ງ')+'</button></div>'+\n  phoneForm()+(ph.length?'<ul class=\"list\">'+ph.map(phoneRow).join('')+'</ul>':empty('ບໍ່ມີການແຈ້ງທາງໂທທີ່ຄ້າງຢູ່'))+'</section>'+\n  '<section class=\"card\"><div class=\"card-head\"><h2>ຕິດຕາມການລາ ແລະ ກັບຄືນ</h2><p class=\"muted\">ຕຳຫຼວດກົດ \"ກັບມາປະຈຳການແລ້ວ\" ເອງໄດ້ ຫຼື ຫົວໜ້າບັນທຶກແທນຢູ່ນີ້</p></div>'+\n  (ap.length?'<ul class=\"list\">'+ap.map(trackRow).join('')+'</ul>':empty('ບໍ່ມີໃບລາທີ່ອະນຸມັດຄ້າງຢູ່'))+'</section>';\n}\nfunction registerData(ym){\n  const inM=state.records.filter(r=>daysIn(r,ym)>0).sort((a,b)=>a.startDate.localeCompare(b.startDate));\n  const ids=Array.from(new Set(actives().map(o=>o.id).concat(inM.map(r=>r.officerId))));\n  const sum=ids.map(id=>{\n    const c={os:0,half:0,full:0,duty:0,abs:0};\n    inM.filter(r=>r.officerId===id&&['approved','returned','absent'].indexOf(r.status)>=0).forEach(r=>{\n      const d=daysIn(r,ym);\n      if(r.status==='absent'){c.abs+=TYPES[r.type].kind==='range'?d:1;return;}\n      if(r.type==='ອຊ')c.os++;else if(r.type==='ລ1'||r.type==='ລ2')c.half++;else if(r.type==='ໜທ')c.duty+=d;else c.full+=d;\n    });\n    c.no=c.full+c.duty+c.abs;c.amt=c.no*RATE;return {o:off(id),c:c};\n  });\n  return {inM:inM,sum:sum};\n}\nfunction summaryTable(sum){\n  return '<div class=\"table-wrap\"><table><thead><tr><th>ຊື່ຕຳຫຼວດ</th><th class=\"num\">ອຊ (ຄັ້ງ)</th><th class=\"num\">ລ1/ລ2 (ຄັ້ງ)</th><th class=\"num\">ລ3/ລ4 (ມື້)</th><th class=\"num\">ໜທ (ມື້)</th><th class=\"num\">ຂາດ (ມື້)</th><th class=\"num\">ມື້ບໍ່ໄດ້ອັດຕາກິນ</th><th class=\"num\">ອັດຕາກິນທີ່ບໍ່ໄດ້ຮັບ</th></tr></thead><tbody>'+\n  sum.map(x=>'<tr><td>'+esc(full(x.o))+'</td><td class=\"num\">'+x.c.os+'</td><td class=\"num\">'+x.c.half+'</td><td class=\"num\">'+x.c.full+'</td><td class=\"num\">'+x.c.duty+'</td><td class=\"num\">'+x.c.abs+'</td><td class=\"num\"><b>'+x.c.no+'</b></td><td class=\"num\">'+money(x.c.amt)+'</td></tr>').join('')+\n  '</tbody></table></div>';\n}\nfunction recordsTable(list,click){\n  return '<div class=\"table-wrap\"><table><thead><tr><th>ເລກທີ</th><th>ວັນທີ</th><th>ຜູ້ລາ</th><th>ປະເພດ</th><th>ຈຳນວນ</th><th>ເຫດຜົນ</th><th>ສະຖານະ</th><th>ກັບຄືນ</th></tr></thead><tbody>'+\n  list.map(r=>'<tr'+(click?' class=\"click\" data-act=\"detail\" data-id=\"'+r.id+'\" tabindex=\"0\"':'')+'><td class=\"no\">'+(r.no||'—')+'</td><td>'+fD(r.startDate)+((r.endDate&&r.endDate!==r.startDate)?'–'+fD(r.endDate):'')+'</td><td>'+esc(full(off(r.officerId)))+'</td><td><b>'+r.type+'</b> '+TYPES[r.type].label+'</td><td>'+qtyText(r)+'</td><td>'+esc(reasonText(r))+'</td><td>'+pill(r)+'</td><td>'+(r.returnedAt?fDT(r.returnedAt):'—')+'</td></tr>').join('')+\n  '</tbody></table></div>';\n}\nconst RULE_NOTE='ອັດຕາກິນ 50,000 ກີບ/ມື້. ອອກຊົ່ວຄາວ ແລະ ລາເຄິ່ງມື້ ບໍ່ຫັກ. ລ3, ລ4, ໜທ ແລະ ຂາດ ບໍ່ໄດ້ອັດຕາກິນ. ນັບສະເພາະໃບລາທີ່ອະນຸມັດ ແລະ ລາຍການ \"ຂາດ\".';\nfunction headRegister(){\n  const months=Array.from(new Set(state.records.map(r=>r.startDate.slice(0,7)).concat([today().slice(0,7)]))).sort().reverse();\n  if(!ui.month||months.indexOf(ui.month)<0)ui.month=today().slice(0,7);\n  const ym=ui.month,d=registerData(ym);\n  return '<section class=\"card\"><div class=\"reg-head\"><h2>ທະບຽນການລາ ປະຈຳເດືອນ</h2>'+\n  '<div class=\"actions\"><label class=\"me\" for=\"reg-month\"><span>ເດືອນ</span><select id=\"reg-month\">'+months.map(m=>'<option value=\"'+m+'\"'+(m===ym?' selected':'')+'>'+monthLabel(m)+'</option>').join('')+'</select></label>'+\n  '<button class=\"btn primary sm\" type=\"button\" data-act=\"export-reg\">ສົ່ງອອກເປັນຮູບພາບ</button></div></div>'+\n  '<h3 class=\"sec\" style=\"margin-top:4px\">ສັງລວມທ້າຍເດືອນ</h3>'+summaryTable(d.sum)+'<p class=\"foot\">'+RULE_NOTE+'</p>'+\n  '<h3 class=\"sec\">ລາຍການໃບລາ ('+d.inM.length+')</h3>'+(d.inM.length?recordsTable(d.inM,true):empty('ບໍ່ມີໃບລາໃນເດືອນນີ້'))+\n  '</section>';\n}\n\n/* ---------- icons ---------- */\nconst ICON={\n  home:'<path d=\"M3 11.5 12 4l9 7.5\"/><path d=\"M5 10v10h14V10\"/><path d=\"M10 20v-6h4v6\"/>',\n  pen:'<path d=\"M4 20h4L19 9l-4-4L4 16v4z\"/><path d=\"m13.5 6.5 4 4\"/>',\n  list:'<rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><path d=\"M8 8h8M8 12h8M8 16h5\"/>',\n  check:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"m8 12.5 2.7 2.7L16.5 9\"/>',\n  clock:'<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>',\n  table:'<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M9 10v10\"/>',\n  gear:'<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z\"/>',\n  phone:'<path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2\"/>',\n  cal:'<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/><path d=\"m9 15 2 2 4-4\"/>',\n  back:'<path d=\"M9 14 4 9l5-5\"/><path d=\"M4 9h11a5 5 0 0 1 0 10h-3\"/>',\n  sheet:'<rect x=\"4\" y=\"3\" width=\"16\" height=\"18\" rx=\"2\"/><path d=\"M4 9h16M4 15h16M10 3v18\"/>',\n  refresh:'<path d=\"M20 11a8 8 0 1 0-2.3 5.7\"/><path d=\"M20 4v7h-7\"/>',\n  user:'<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>',\n  cam:'<path d=\"M4 8h3l2-3h6l2 3h3v11H4z\"/><circle cx=\"12\" cy=\"13\" r=\"3.5\"/>'\n};\nconst ic=k=>'<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">'+ICON[k]+'</svg>';\nconst initials=o=>esc(((o&&o.name)||'?').trim().slice(0,1));\n/* officer photo (from the hidden LeavePhotos sheet) or the first letter of the name */\nconst photoOf=o=>(o&&state.photos&&state.photos[String(o.id)])||'';\nconst avatar=(o,cls)=>{const p=photoOf(o);return '<span class=\"avatar'+(p?' has-ph':'')+(cls?' '+cls:'')+'\">'+(p?'<img src=\"'+esc(p)+'\" alt=\"\">':initials(o))+'</span>';};\n\n/* ---------- who are you ---------- */\nfunction whoView(){\n  return '<h2 class=\"who-h\">ທ່ານແມ່ນໃຜ?</h2><p class=\"who-p\">ເລືອກຊື່ຂອງທ່ານ ເພື່ອເລີ່ມໃຊ້ງານ · ເຄື່ອງນີ້ຈະຈື່ໄວ້</p><div class=\"whos\">'+\n    actives().map(o=>'<button class=\"who-btn\" type=\"button\" data-act=\"pick\" data-id=\"'+esc(o.id)+'\">'+avatar(o)+'<span><b>'+esc(full(o))+'</b><span class=\"r-sub\">ຕຳຫຼວດປະຈຳການ · '+esc(o.phone||'')+'</span></span></button>').join('')+\n    '<button class=\"who-btn head\" type=\"button\" data-act=\"pick\" data-id=\"__head\"><span class=\"avatar\">'+ic('user')+'</span><span><b>ຫົວໜ້າໜ່ວຍບໍລິການ</b><span class=\"r-sub\">ອະນຸມັດ, ຕິດຕາມ ແລະ ສັງລວມການລາ (ຕ້ອງມີລະຫັດ)</span></span></button>'+\n    '</div>';\n}\nfunction userBar(){\n  const head=state.role==='head';\n  const o=head?null:off(state.me);\n  return '<div class=\"userbar\"><div class=\"who\">'+(head?'<span class=\"avatar\">'+ic('user')+'</span>':avatar(o))+'<span class=\"nm\"><b>'+(head?'ຫົວໜ້າໜ່ວຍບໍລິການ':esc(full(o)))+'</b><small>'+(head?(ui.headAuthed?'ເຂົ້າລະບົບແລ້ວ':'ຍັງບໍ່ເຂົ້າລະບົບ'):'ຕຳຫຼວດປະຈຳການ')+'</small></span></div>'+\n    '<div class=\"actions\">'+(head&&ui.headAuthed?'<button class=\"btn ghost sm\" type=\"button\" data-act=\"logout\">ອອກຈາກລະບົບ</button>':'')+'<button class=\"btn ghost sm\" type=\"button\" data-act=\"who\">ປ່ຽນຜູ້ໃຊ້</button></div></div>';\n}\n\n/* ---------- today board ---------- */\nfunction todayStatus(o){\n  const now=new Date(),T=today();\n  const rs=state.records.filter(r=>String(r.officerId)===String(o.id)&&['approved','phone','returned'].indexOf(r.status)>=0);\n  for(const r of rs){const s=span(r);if(r.status!=='returned'&&!r.returnedAt&&now>=s[0]&&now<=new Date(Math.max(s[1],expRet(r))))return ['ກຳລັງລາ · '+r.type+' '+TYPES[r.type].label,'warn','ກຳນົດກັບ '+fDate(expRet(r))];}\n  for(const r of rs){const s=span(r);if(now>expRet(r)&&!r.returnedAt&&r.status==='approved')return ['ເກີນກຳນົດກັບ','bad',r.type+' '+TYPES[r.type].label];}\n  for(const r of rs){if(r.status==='approved'&&iso(span(r)[0])===T&&now<span(r)[0])return ['ປະຈຳການ · ຈະລາ '+hm(span(r)[0]),'accent',r.type+' '+TYPES[r.type].label];}\n  return ['ປະຈຳການ','good',''];\n}\nconst p2=n=>(n<10?'0':'')+n;\nconst clockText=()=>{const d=new Date();return p2(d.getHours())+':'+p2(d.getMinutes())+':'+p2(d.getSeconds());};\nconst kip=n=>Math.round(Number(n)||0).toLocaleString('en-US');\nfunction attPart(it,mine){\n  if(!it)return '';\n  if(it.present)return '<span class=\"pill good\">'+ic('check')+' ລົງເວລາແລ້ວ</span>';\n  if(mine)return '<button class=\"btn primary sm att-in\" type=\"button\" data-act=\"att-in\" data-id=\"'+esc(it.id)+'\">'+ic('clock')+' ລົງເວລາເຂົ້າ</button>';\n  return '<span class=\"pill\">ຍັງບໍ່ລົງເວລາ</span>';\n}\nfunction board(){\n  const a=ui.att,ok=a&&!a.err&&a.items,off2=state.role==='officer';\n  const by={};if(ok)a.items.forEach(it=>{by[String(it.id)]=it;});\n  const me=off2?by[String(state.me)]:null;\n  let note='';\n  if(!a)note='<p class=\"muted att-note\">ກຳລັງໂຫຼດຂໍ້ມູນບັນທຶກປະຈຳການ…</p>';\n  else if(a.err)note='<p class=\"muted att-note\">'+(a.err==='OLD'?'ລະບົບບັນທຶກປະຈຳການຍັງບໍ່ເຊື່ອມ: ຕ້ອງອັບເດດ Leave.gs ໃນ Apps Script':'ໂຫຼດບັນທຶກປະຈຳການບໍ່ໄດ້: '+esc(a.err))+'</p>';\n  return '<section class=\"card att\"><div class=\"att-top\"><div class=\"card-head\"><h2>ບັນທຶກປະຈຳການ · ມື້ນີ້</h2><p class=\"muted\">ວັນ'+wd(today())+' '+fD(today())+'</p></div><div class=\"att-clock\" id=\"att-clock\" aria-label=\"ເວລາປັດຈຸບັນ\">'+clockText()+'</div></div>'+\n    note+\n    (me&&me.name?'<p class=\"att-me\">ເດືອນນີ້ທ່ານປະຈຳການ <b>'+me.month+' ມື້</b> · ອັດຕາກິນ <b>'+kip(me.money)+' ກີບ</b></p>':'')+\n    '<ul class=\"board\">'+\n    actives().map(o=>{\n      const s=todayStatus(o),it=by[String(o.id)],mine=off2&&String(o.id)===String(state.me);\n      const sub=[s[2],(it&&it.name&&!off2?'ເດືອນນີ້ ປະຈຳການ '+it.month+' ມື້':'')].filter(Boolean).join(' · ');\n      const leavePill=(!ok||s[1]!=='good')?'<span class=\"pill '+s[1]+'\">'+esc(s[0])+'</span>':'';\n      return '<li'+(mine?' class=\"me\"':'')+'><span class=\"b-nm\">'+avatar(o,'sm')+'<span><b>'+esc(full(o))+'</b>'+(sub?'<span class=\"r-sub\">'+esc(sub)+'</span>':'')+'</span></span><span class=\"b-st\">'+leavePill+(ok?attPart(it,mine):'')+'</span></li>';\n    }).join('')+'</ul></section>';\n}\nconst tile=(icon,title,sub,act,id,badge,cls)=>'<button class=\"tile'+(cls?' '+cls:'')+'\" type=\"button\" data-act=\"'+act+'\"'+(id?' data-id=\"'+id+'\"':'')+'><span class=\"ti\">'+ic(icon)+'</span><b>'+title+'</b><small>'+sub+'</small>'+(badge?'<span class=\"badge\">'+badge+'</span>':'')+'</button>';\nconst linkTile=(icon,title,sub,href)=>'<a class=\"tile\" href=\"'+esc(href)+'\" target=\"_top\" rel=\"noopener\"><span class=\"ti\">'+ic(icon)+'</span><b>'+title+'</b><small>'+sub+'</small></a>';\nfunction officerHome(){\n  const now=new Date(),o=off(state.me);\n  const mine=state.records.filter(r=>String(r.officerId)===String(state.me));\n  const out=mine.filter(r=>r.status==='approved'&&now>=span(r)[0]);\n  const ph=mine.filter(r=>r.status==='phone');\n  const pend=mine.filter(r=>r.status==='pending').length;\n  return '<div><p class=\"hello\">ສະບາຍດີ, '+esc(full(o))+'</p><p class=\"muted\" style=\"margin:0\">ຕ້ອງການເຮັດຫຍັງມື້ນີ້?</p></div>'+\n    out.map(r=>{const er=expRet(r),over=now>er;return '<div class=\"card alert go\"><div><b>'+(over?'ເກີນກຳນົດກັບແລ້ວ':'ທ່ານກຳລັງລາຢູ່')+'</b> · <span class=\"no\">'+esc(r.no)+'</span><p>'+r.type+' '+TYPES[r.type].label+' · ກຳນົດກັບ '+fDate(er)+'</p></div><div class=\"actions\"><button class=\"btn primary\" type=\"button\" data-act=\"self-return\" data-id=\"'+r.id+'\">'+ic('back')+' ກັບຄືນແລ້ວ</button></div></div>';}).join('')+\n    ph.map(r=>'<div class=\"card alert\"><div><b>ທ່ານໄດ້ແຈ້ງລາທາງໂທ</b><p>'+dueText(r)+'</p></div><div class=\"actions\"><button class=\"btn primary\" type=\"button\" data-act=\"write-retro\" data-id=\"'+r.id+'\">ຂຽນໃບລາຍ້ອນຫຼັງ</button></div></div>').join('')+\n    board()+\n    '<div class=\"tiles one\">'+\n      tile('list','ໃບລາຂອງຂ້ອຍ',pend?pend+' ໃບ ລໍຖ້າອະນຸມັດ':'ສະຫຼຸບຈຳນວນຄັ້ງທີ່ລາ · ເບິ່ງສະຖານະ ແລະ ສົ່ງອອກຮູບ','tab','mine',out.length+ph.length)+\n    '</div>';\n}\nfunction headHome(){\n  const now=new Date(),recs=state.records;\n  const pend=recs.filter(r=>r.status==='pending').length;\n  const trackN=recs.filter(r=>r.status==='phone').length+recs.filter(r=>r.status==='approved'&&span(r)[0]<=now).length+unacked().length;\n  return '<div class=\"tiles\">'+\n    tile('check','ອະນຸມັດໃບລາ',pend?pend+' ໃບ ລໍຖ້າ':'ບໍ່ມີໃບລາລໍຖ້າ','tab','approve',pend,'main')+\n    tile('clock','ຕິດຕາມ','ແຈ້ງທາງໂທ, ກັບຄືນ','tab','track',trackN)+\n    tile('table','ທະບຽນ ແລະ ສັງລວມ','ສັງລວມອັດຕາກິນປະຈຳເດືອນ','tab','register')+\n    linkTile('sheet','ເປີດ Google Sheet','ແຜ່ນ ບັນທຶກການລາ',SHEET_URL)+\n  '</div>'+board()+\n  '<div class=\"tiles\" style=\"grid-template-columns:1fr\">'+linkTile('cal','ບັນທຶກປະຈຳການ','ໄປທີ່ລະບົບບັນທຶກປະຈຳການ ແລະ ລາຍງານອັດຕາກິນ',BASE_URL)+'</div>';\n}\n\n/* ---------- ໃບລາຂອງຂ້ອຍ + ສະຫຼຸບ ---------- */\nconst USED=['approved','returned','phone'];\nconst r1=n=>Math.round(n*10)/10;\nfunction mineSummary(mine){\n  const R=ui.mineRange,T=today(),Y=T.slice(0,4),M=T.slice(0,7);\n  const rs=mine.filter(r=>R==='all'||(R==='year'?r.startDate.slice(0,4)===Y:r.startDate.slice(0,7)===M));\n  const used=rs.filter(r=>USED.indexOf(r.status)>=0);\n  const n=st=>rs.filter(r=>r.status===st).length;\n  const noMeal=rs.reduce((t,r)=>t+lvNoMealDays_(r),0);\n  const seg=[['month','ເດືອນນີ້'],['year','ປີ '+Y],['all','ທັງໝົດ']].map(x=>'<button type=\"button\" data-act=\"mine-range\" data-id=\"'+x[0]+'\" aria-pressed=\"'+(x[0]===R)+'\">'+x[1]+'</button>').join('');\n  const kpi=(v,l,c)=>'<div class=\"kpi'+(c?' '+c:'')+'\"><b>'+v+'</b><span>'+l+'</span></div>';\n  const rows=Object.keys(TYPES).map(k=>{\n    const xs=used.filter(r=>r.type===k);if(!xs.length)return '';\n    const t=TYPES[k],q=xs.reduce((s,r)=>s+lvQty_(r),0);\n    const amt=t.kind==='time'?r1(q)+' ຊົ່ວໂມງ':(r1(q)+' ມື້');\n    return '<li><span><b>'+k+'</b> '+t.label+'</span><span><b>'+xs.length+' ຄັ້ງ</b> · '+amt+'</span></li>';\n  }).join('');\n  return '<section class=\"card\"><div class=\"card-head sum-head\"><div><h2>ສະຫຼຸບການລາຂອງຂ້ອຍ</h2><p class=\"muted\">ນັບຕາມວັນທີເລີ່ມລາ</p></div><div class=\"seg\" role=\"group\" aria-label=\"ຊ່ວງເວລາ\">'+seg+'</div></div>'+\n    '<div class=\"kpis\">'+kpi(used.length,'ຄັ້ງທີ່ລາ','main')+kpi(n('pending'),'ລໍຖ້າອະນຸມັດ')+kpi(n('rejected'),'ບໍ່ອະນຸມັດ')+kpi(n('absent'),'ຂາດ',n('absent')?'bad':'')+'</div>'+\n    (rows?'<ul class=\"bytype\">'+rows+'</ul>':'<p class=\"empty\">ບໍ່ມີການລາໃນຊ່ວງນີ້</p>')+\n    '<p class=\"sum-foot\">ມື້ທີ່ບໍ່ໄດ້ອັດຕາກິນ (ລາໝົດມື້ / ຫຼາຍມື້ / ຂາດ): <b>'+r1(noMeal)+' ມື້</b></p></section>';\n}\nfunction officerMine(){\n  const now=new Date();\n  const mine=state.records.filter(r=>String(r.officerId)===String(state.me)).sort((a,b)=>b.startDate.localeCompare(a.startDate));\n  const ph=mine.filter(r=>r.status==='phone');\n  const out=mine.filter(r=>r.status==='approved'&&now>=span(r)[0]);\n  return out.map(r=>{const er=expRet(r),over=now>er;return '<div class=\"card alert go\"><div><b>'+(over?'ເກີນກຳນົດກັບແລ້ວ':'ກຳລັງລາຢູ່')+'</b> · <span class=\"no\">'+esc(r.no)+'</span><p>'+r.type+' '+TYPES[r.type].label+' · '+esc(period(r))+' · ກຳນົດກັບ '+fDate(er)+'</p><p class=\"muted\">ເມື່ອກັບຮອດຫ້ອງການ ກົດ \"ກັບຄືນ\" ລະບົບຈະບັນທຶກເວລາ ແລະ ແຈ້ງຫົວໜ້າໜ່ວຍບໍລິການ</p></div><div class=\"actions\"><button class=\"btn primary\" type=\"button\" data-act=\"self-return\" data-id=\"'+r.id+'\">ກັບຄືນ</button><button class=\"btn ghost\" type=\"button\" data-act=\"detail\" data-id=\"'+r.id+'\">ເປີດໃບລາ</button></div></div>';}).join('')+\n  ph.map(r=>'<div class=\"card alert\"><div><b>ທ່ານໄດ້ແຈ້ງລາທາງໂທລະສັບ</b><p>'+r.type+' '+TYPES[r.type].label+' · '+esc(period(r))+' · ໂທແຈ້ງ '+esc(r.callTo)+' ເວລາ '+esc(r.callTime)+'</p><p>'+dueText(r)+(r.returnedAt?' · ກັບມາແລ້ວ '+fDT(r.returnedAt):'')+'</p></div><div class=\"actions\">'+(canSelfReturn(r)?'<button class=\"btn primary\" type=\"button\" data-act=\"self-return\" data-id=\"'+r.id+'\">ກັບຄືນ</button>':'')+'<button class=\"btn '+(canSelfReturn(r)?'ghost':'primary')+'\" type=\"button\" data-act=\"write-retro\" data-id=\"'+r.id+'\">ຂຽນໃບລາຍ້ອນຫຼັງ</button></div></div>').join('')+\n  mineSummary(mine)+\n  '<section class=\"card\"><div class=\"card-head\"><h2>ປະຫວັດໃບລາ</h2><p class=\"muted\">'+mine.length+' ລາຍການ · ກົດເພື່ອເບິ່ງໃບລາ ຫຼື ສົ່ງອອກເປັນຮູບພາບ</p></div>'+\n  (mine.length?'<ul class=\"list\">'+mine.map(r=>itemRow(r,false)).join('')+'</ul>':empty('ຍັງບໍ່ມີໃບລາ'))+'</section>';\n}\n\n/* ---------- ຕັ້ງຄ່າ: ລາຍຊື່ເຈົ້າໜ້າທີ່ (ມີຮູບ) ---------- */\nfunction photoPick(o){\n  const p=photoOf(o);\n  return '<label class=\"ph-pick\" title=\"'+(p?'ປ່ຽນຮູບ':'ເພີ່ມຮູບ')+'\">'+avatar(o,'lg')+'<span class=\"ph-cam\">'+ic('cam')+'</span><input type=\"file\" accept=\"image/*\" data-photo=\"'+esc(o.id)+'\" aria-label=\"'+(p?'ປ່ຽນຮູບ ':'ເພີ່ມຮູບ ')+esc(full(o))+'\"></label>';\n}\nfunction headStaff(){\n  const act=actives(),s=state.settings;\n  return '<section class=\"card\"><div class=\"card-head\"><h2>ລາຍຊື່ເຈົ້າໜ້າທີ່ຕຳຫຼວດ</h2><p class=\"muted\">'+act.length+' ທ່ານ · ກົດທີ່ຮູບເພື່ອເພີ່ມ ຫຼື ປ່ຽນຮູບ · ລົບອອກຈາກລາຍຊື່ແລ້ວ ປະຫວັດການລາຍັງເກັບໄວ້</p></div>'+\n  '<ul class=\"list\">'+act.map(o=>'<li class=\"staff\"><div class=\"st-who\">'+photoPick(o)+'<div><b>'+esc(full(o))+'</b><span class=\"r-sub\">'+esc(o.phone||'—')+'</span>'+\n    (photoOf(o)?'<button class=\"linkbtn\" type=\"button\" data-act=\"staff-photo-del\" data-id=\"'+esc(o.id)+'\">ລົບຮູບ</button>':'<span class=\"r-sub ph-hint\">ຍັງບໍ່ມີຮູບ</span>')+'</div></div>'+\n    (ui.confirmDel===o.id?'<div class=\"actions\"><span class=\"form-msg bad\">ລົບ '+esc(full(o))+' ອອກຈາກລາຍຊື່?</span><button class=\"btn danger sm\" type=\"button\" data-act=\"staff-del\" data-id=\"'+o.id+'\">ຢືນຢັນລົບ</button><button class=\"btn ghost sm\" type=\"button\" data-act=\"staff-del-cancel\">ຍົກເລີກ</button></div>'\n    :'<button class=\"btn ghost sm\" type=\"button\" data-act=\"staff-del-ask\" data-id=\"'+o.id+'\">ລົບອອກ</button>')+'</li>').join('')+'</ul>'+\n  '<div class=\"subform\" style=\"margin:14px 0 0\"><b>ເພີ່ມເຈົ້າໜ້າທີ່ໃໝ່</b><div class=\"st-new\">'+\n    '<div class=\"ph-new\"><label class=\"ph-pick\" title=\"ເລືອກຮູບ\"><span class=\"avatar lg'+(ui.newPhoto?' has-ph':'')+'\" id=\"st-ph-prev\">'+(ui.newPhoto?'<img src=\"'+esc(ui.newPhoto)+'\" alt=\"\">':ic('cam'))+'</span><input type=\"file\" accept=\"image/*\" data-photo=\"__new\" aria-label=\"ເລືອກຮູບເຈົ້າໜ້າທີ່\"></label>'+\n      '<span class=\"ph-lbl\">ຮູບ</span><button class=\"linkbtn\" type=\"button\" id=\"st-ph-clear\" data-act=\"st-ph-clear\"'+(ui.newPhoto?'':' hidden')+'>ລົບຮູບ</button></div>'+\n    '<div class=\"row\">'+\n    '<div class=\"field\"><label for=\"st-rank\">ຍົດ</label><input id=\"st-rank\" placeholder=\"ເຊັ່ນ ສທ, ພັຕ\"></div>'+\n    '<div class=\"field\"><label for=\"st-name\">ຊື່ ແລະ ນາມສະກຸນ</label><input id=\"st-name\"></div>'+\n    '<div class=\"field\"><label for=\"st-phone\">ເບີໂທ</label><input id=\"st-phone\" inputmode=\"tel\"></div></div></div>'+\n    '<p class=\"form-msg\" id=\"st-msg\" role=\"status\"></p><div class=\"actions\"><button class=\"btn primary\" type=\"button\" data-act=\"staff-add\">ເພີ່ມເຂົ້າລາຍຊື່</button></div></div></section>'+\n  '<section class=\"card\"><div class=\"card-head\"><h2>ຕັ້ງຄ່າ</h2><p class=\"muted\">ເບີໂທຂອງຫົວໜ້າໜ່ວຍບໍລິການ (ເກັບໄວ້ໃນລະບົບ · ບໍ່ສະແດງໃນໜ້າຕຳຫຼວດ)</p></div><div class=\"row\">'+\n    '<div class=\"field\"><label for=\"set-phone\">ເບີໂທແຈ້ງລາສຸກເສີນ (ຫົວໜ້າໜ່ວຍ)</label><input id=\"set-phone\" inputmode=\"tel\" value=\"'+esc(s.unitPhone)+'\" placeholder=\"020 …\"></div>'+\n    '<div class=\"field\"><label for=\"set-pass\">ລະຫັດ admin ໃໝ່ (ປ່ອຍຫວ່າງ = ບໍ່ປ່ຽນ)</label><input id=\"set-pass\" type=\"password\" autocomplete=\"new-password\" placeholder=\"ຢ່າງໜ້ອຍ 4 ຕົວ\"></div></div>'+\n    '<p class=\"form-msg\" id=\"set-msg\" role=\"status\"></p><div class=\"actions\"><button class=\"btn primary\" type=\"button\" data-act=\"settings-save\">ບັນທຶກການຕັ້ງຄ່າ</button></div></section>';\n}\n/* resize + square-crop a chosen picture in the browser: ~200x200 JPEG, small enough for one sheet cell */\nfunction shrinkPhoto(file){\n  return new Promise((res,rej)=>{\n    if(!file||(file.type&&!/^image\\//.test(file.type))){rej(new Error('ກະລຸນາເລືອກໄຟລ໌ຮູບພາບ'));return;}\n    const url=URL.createObjectURL(file),img=new Image();\n    img.onload=()=>{\n      const S=200,c=document.createElement('canvas'),g=c.getContext('2d');c.width=c.height=S;\n      const w=img.naturalWidth,h=img.naturalHeight,k=Math.min(w,h);\n      g.fillStyle='#fff';g.fillRect(0,0,S,S);\n      g.drawImage(img,(w-k)/2,(h-k)/2*0.6,k,k,0,0,S,S); /* tall photos: keep a bit more of the top (face) */\n      URL.revokeObjectURL(url);\n      let q=0.85,d=c.toDataURL('image/jpeg',q);\n      while(d.length>40000&&q>0.35){q-=0.1;d=c.toDataURL('image/jpeg',q);}\n      res(d);\n    };\n    img.onerror=()=>{URL.revokeObjectURL(url);rej(new Error('ອ່ານຮູບນີ້ບໍ່ໄດ້: ລອງເລືອກຮູບ JPG ຫຼື PNG'));};\n    img.src=url;\n  });\n}\n/* re-render without losing what was typed in the add-officer form */\nfunction renderKeepStaff(){\n  const keep=['st-rank','st-name','st-phone','set-phone'].map(i=>[i,($('#'+i)||{}).value]);\n  render();\n  keep.forEach(x=>{const el=$('#'+x[0]);if(el&&x[1]!=null)el.value=x[1];});\n}\ndocument.addEventListener('change',e=>{\n  const el=e.target;\n  if(!el.matches||!el.matches('input[type=\"file\"][data-photo]'))return;\n  const id=el.dataset.photo,f=el.files&&el.files[0];\n  if(!f)return;\n  shrinkPhoto(f).then(p=>{\n    el.value='';\n    if(id==='__new'){\n      ui.newPhoto=p;\n      const v=$('#st-ph-prev');if(v){v.innerHTML='<img src=\"'+p+'\" alt=\"\">';v.classList.add('has-ph');}\n      const c=$('#st-ph-clear');if(c)c.hidden=false;\n      return;\n    }\n    const o=off(id);\n    return api('staffPhoto',{id:id,photo:p}).then(()=>{renderKeepStaff();toast('ບັນທຶກຮູບ '+full(o)+' ແລ້ວ');});\n  }).catch(err=>{el.value='';fail(err);});\n});\n\n/* ---------- routing ---------- */\nfunction tabsFor(head){\n  const recs=state.records,now=new Date();\n  if(!head){\n    const myN=recs.filter(r=>String(r.officerId)===String(state.me)&&(r.status==='phone'||(r.status==='approved'&&span(r)[0]<=now))).length;\n    return [['home','ໜ້າຫຼັກ','home',0],['new','ຂຽນໃບລາ','pen',0],['mine','ໃບລາຂອງຂ້ອຍ','list',myN]];\n  }\n  const pend=recs.filter(r=>r.status==='pending').length;\n  const trackN=recs.filter(r=>r.status==='phone').length+recs.filter(r=>r.status==='approved'&&span(r)[0]<=now).length+unacked().length;\n  return [['home','ໜ້າຫຼັກ','home',0],['approve','ອະນຸມັດ','check',pend],['track','ຕິດຕາມ','clock',trackN],['register','ທະບຽນ','table',0],['staff','ຕັ້ງຄ່າ','gear',0]];\n}\nfunction view(k){\n  if(state.role==='officer'){if(k==='mine')return officerMine();if(k==='new')return officerNew();return officerHome();}\n  if(!ui.headAuthed)return loginView();\n  if(k==='approve')return headApprove();\n  if(k==='track')return headTrack();\n  if(k==='register')return headRegister();\n  if(k==='staff')return headStaff();\n  return headHome();\n}\nfunction renderNav(tabs,cur){\n  const n=$('#bnav');\n  if(!tabs){n.hidden=true;return;}\n  n.hidden=false;\n  n.innerHTML='<div class=\"bnav-in\">'+tabs.map(t=>'<button type=\"button\" data-act=\"tab\" data-id=\"'+t[0]+'\"'+(t[0]===cur?' aria-current=\"page\"':'')+'>'+ic(t[2])+'<span>'+t[1]+'</span>'+(t[3]?'<span class=\"badge\">'+t[3]+'</span>':'')+'</button>').join('')+'</div>';\n}\nfunction render(){\n  const app=$('#app');\n  $('#demo').hidden=IS_GAS;\n  if(!ui.loaded){\n    app.innerHTML=ui.loadErr?'<section class=\"card err-card\"><div class=\"card-head\"><h2>ໂຫຼດຂໍ້ມູນບໍ່ສຳເລັດ</h2><p class=\"muted\">'+esc(ui.loadErr)+'</p></div><button class=\"btn primary\" type=\"button\" data-act=\"reload\">ລອງໃໝ່</button></section>':'<div class=\"skel\"><div></div><div></div><div></div></div>';\n    renderNav(null);return;\n  }\n  ensureMe();\n  if(!prefs.chosen){app.innerHTML=whoView();renderNav(null);return;}\n  if(!draft||String(draft.officerId)!==String(state.me))draft=newDraft();\n  const head=state.role==='head';\n  const tabs=tabsFor(head);\n  let cur=state.tab[state.role];\n  if(!tabs.find(t=>t[0]===cur))cur=state.tab[state.role]='home';\n  app.innerHTML=userBar()+'<div class=\"view\">'+view(cur)+'</div>';\n  renderNav(head&&!ui.headAuthed?null:tabs,cur);\n  if(!head&&cur==='new')dyn();\n  if(head&&!ui.headAuthed){const p=$('#lg-pass');if(p)p.focus();}\n}\n\n/* ---------- actions ---------- */\nconst H={\n  'att-in':(id,b)=>{\n    if(String(id)!==String(state.me))return;\n    api('attCheckin',{id:id},b).then(res=>{ui.att=res.att||ui.att;render();toast(res.already?'ທ່ານລົງເວລາມື້ນີ້ໄວ້ແລ້ວ':'ລົງເວລາເຂົ້າປະຈຳການແລ້ວ · '+clockText().slice(0,5));}).catch(e=>fail(e));\n  },\n  'mine-range':id=>{ui.mineRange=id;render();},\n  reload:()=>{ui.loadErr='';render();refresh(true);},\n  refresh:()=>refresh(false),\n  who:()=>{prefs.chosen=false;save();render();window.scrollTo(0,0);},\n  pick:id=>{\n    if(id==='__head'){state.role='head';state.tab.head='home';}\n    else{state.role='officer';state.me=id;state.tab.officer='home';draft=newDraft();}\n    prefs.chosen=true;save();render();window.scrollTo(0,0);\n  },\n  tab:id=>{state.tab[state.role]=id;ui.confirmDel=null;save();render();window.scrollTo(0,0);},\n  logout:()=>{api('logout').catch(()=>{}).then(()=>{setToken('');render();toast('ອອກຈາກລະບົບແລ້ວ');});},\n  detail:id=>openDetail(id),\n  close:()=>closeModal(),\n  xclose:()=>{$('#xmodal').hidden=true;},\n  'write-retro':id=>{const r=get(id);draft=Object.assign(newDraft(),{type:r.type,startDate:r.startDate,endDate:r.endDate||r.startDate,timeFrom:r.timeFrom||'09:00',timeTo:r.timeTo||'10:00',detail:r.detail||'',filing:'retro',callTime:r.callTime,callTo:r.callTo,linkId:r.id});state.tab.officer='new';render();window.scrollTo(0,0);},\n  'export-leave':(id,b)=>{const r=get(id);exportImage(paperHTML(r,false),leaveFile(r),720,b);},\n  'export-reg':(id,b)=>{exportImage(regExportHTML(ui.month),'ທະບຽນການລາ-'+ui.month+'.png',1180,b);},\n  'x-save':()=>{\n    if(!X)return;\n    const a=document.createElement('a');a.href=URL.createObjectURL(X.blob);a.download=X.filename;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},1500);\n  },\n  'x-copy':()=>{\n    if(!X)return;\n    try{\n      if(!navigator.clipboard||!window.ClipboardItem)throw new Error('no');\n      navigator.clipboard.write([new ClipboardItem({'image/png':X.blob})]).then(()=>toast('ສຳເນົາຮູບແລ້ວ · ວາງ (Paste) ໃນກຸ່ມແຊັດໄດ້ເລີຍ'),()=>toast('ສຳເນົາບໍ່ໄດ້ໃນເຄື່ອງນີ້: ກົດຄ້າງທີ່ຮູບແທນ'));\n    }catch(e){toast('ສຳເນົາບໍ່ໄດ້ໃນເຄື່ອງນີ້: ກົດຄ້າງທີ່ຮູບແທນ');}\n  },\n  'self-return':(id,b)=>{\n    api('selfReturn',{id:id},b).then(()=>{const r=get(id);render();openDetail(id,'ກັບຄືນ '+fDT(r.returnedAt)+(r.late>0.01?' (ຊ້າ '+fmtH(r.late)+')':'')+' · ແຈ້ງຫົວໜ້າໜ່ວຍບໍລິການແລ້ວ');}).catch(e=>fail(e));\n  },\n  approve:(id,b)=>{\n    const r=get(id),ta=$('#cm-'+id),m=$('#am-'+id),u=pendUI[id]=pendUI[id]||{};\n    u.comment=ta.value;u.by=$('#by-'+id).value;\n    const v=ta.value.trim();\n    if(v.indexOf('ບໍ່ອະນຸມັດ')===0){m.textContent='ຄຳເຫັນຂຽນວ່າ \"ບໍ່ອະນຸມັດ\": ແກ້ຄຳເຫັນ ຫຼື ກົດປຸ່ມ ບໍ່ອະນຸມັດ.';m.className='form-msg bad';return;}\n    const nb=checks(r).filter(c=>c.lv==='bad').length;\n    if(nb&&u.arm!=='approve'){u.arm='approve';m.textContent='ໃບລານີ້ມີ '+nb+' ຂໍ້ບໍ່ຖືກລະບຽບ (✕). ກົດ ອະນຸມັດ ອີກຄັ້ງເພື່ອຢືນຢັນ.';m.className='form-msg bad';return;}\n    api('approve',{id:id,by:u.by.trim()||HEAD,comment:v||approveText(r)},b).then(()=>{delete pendUI[id];render();openDetail(id,'ອະນຸມັດແລ້ວ · ສົ່ງອອກເປັນຮູບເພື່ອແຈ້ງໃນກຸ່ມ');}).catch(e=>fail(e,m));\n  },\n  reject:(id,b)=>{\n    const ta=$('#cm-'+id),m=$('#am-'+id),u=pendUI[id]=pendUI[id]||{};\n    const prefix='ບໍ່ອະນຸມັດ ເນື່ອງຈາກ ';\n    const v=ta.value.trim();\n    if(v.indexOf('ບໍ່ອະນຸມັດ')!==0){ta.value=prefix;u.comment=prefix;ta.focus();ta.setSelectionRange(ta.value.length,ta.value.length);m.textContent='ຂຽນເຫດຜົນທີ່ບໍ່ອະນຸມັດ ແລ້ວກົດ ບໍ່ອະນຸມັດ ອີກຄັ້ງ.';m.className='form-msg warn';return;}\n    if(v.length<prefix.trim().length+4){ta.focus();m.textContent='ກະລຸນາຂຽນເຫດຜົນໃຫ້ຊັດເຈນ.';m.className='form-msg bad';return;}\n    api('reject',{id:id,by:$('#by-'+id).value.trim()||HEAD,comment:v},b).then(()=>{delete pendUI[id];render();openDetail(id,'ບໍ່ອະນຸມັດແລ້ວ · ສົ່ງອອກເປັນຮູບເພື່ອແຈ້ງໃນກຸ່ມ');}).catch(e=>fail(e,m));\n  },\n  ack:(id,b)=>{api('ack',{id:id},b).then(()=>{render();toast('ຮັບຊາບການກັບຄືນແລ້ວ');}).catch(e=>fail(e));},\n  'phone-open':()=>{ui.phoneOpen=!ui.phoneOpen;render();},\n  'phone-cancel':()=>{ui.phoneOpen=false;render();},\n  'phone-save':(id,b)=>{\n    const type=$('#pf-t').value,d=$('#pf-d').value,m=$('#pf-msg');\n    const tf=$('#pf-tf').value,tt=$('#pf-tt').value,ct=$('#pf-ct').value,by=$('#pf-by').value.trim();\n    if(!d||!ct||!by){m.textContent='ກະລຸນາໃສ່ວັນທີ, ເວລາໂທ ແລະ ຜູ້ຮັບແຈ້ງ.';m.className='form-msg bad';return;}\n    if(type==='ອຊ'&&(!tf||!tt||tt<=tf)){m.textContent='ອອກຊົ່ວຄາວ: ໃສ່ເວລາອອກ ແລະ ເວລາກັບໃຫ້ຖືກຕ້ອງ.';m.className='form-msg bad';return;}\n    const oid=$('#pf-o').value,o=off(oid),h=actives().find(x=>String(x.id)!==String(oid));\n    const r={officerId:oid,type:type,startDate:d,endDate:d,timeFrom:type==='ອຊ'?tf:'',timeTo:type==='ອຊ'?tt:'',detail:$('#pf-note').value.trim(),phone:o.phone,filing:'retro',callTime:ct,callTo:by,handoverTo:h?h.id:''};\n    const clash=checks(Object.assign({id:'__p',reason:'',destination:'',emergencyName:'',emergencyPhone:'',pksReplacement:''},r)).find(c=>c.lv==='bad'&&c.tx.indexOf('ຫ້າມລາພ້ອມກັນ')===0);\n    api('phoneSave',{rec:r},b).then(()=>{ui.phoneOpen=false;render();toast(clash?'ບັນທຶກແລ້ວ · ລະວັງ: ບໍ່ມີຄົນຢູ່ປະຈຳການ ໃຫ້ຂໍຄົນແທນຈາກ ປກສ':'ບັນທຶກການແຈ້ງທາງໂທແລ້ວ · ລໍຖ້າໃບລາຍ້ອນຫຼັງ');}).catch(e=>fail(e,m));\n  },\n  'ret-save':(id,b)=>{\n    const v=$('#ret-'+id).value;\n    if(!v){toast('ກະລຸນາໃສ່ເວລາກັບ');return;}\n    api('retSave',{id:id,at:v.slice(0,16)},b).then(()=>{const r=get(id);render();toast(r.late>0.01?'ບັນທຶກກັບຄືນແລ້ວ · ຊ້າ '+fmtH(r.late):'ບັນທຶກກັບຄືນແລ້ວ · ກັບຕາມກຳນົດ');}).catch(e=>fail(e));\n  },\n  absent:(id,b)=>{api('absent',{id:id},b).then(()=>{render();toast('ໝາຍເປັນ \"ຂາດ\" ແລ້ວ');}).catch(e=>fail(e));},\n  'staff-del-ask':id=>{ui.confirmDel=id;render();},\n  'staff-del-cancel':()=>{ui.confirmDel=null;render();},\n  'staff-del':(id,b)=>{\n    const o=off(id);\n    api('staffDel',{id:id},b).then(()=>{ui.confirmDel=null;ensureMe();if(String(draft.officerId)===String(id)||String(draft.handoverTo)===String(id))draft=newDraft();render();toast('ລົບ '+full(o)+' ອອກຈາກລາຍຊື່ແລ້ວ');}).catch(e=>{ui.confirmDel=null;render();fail(e);});\n  },\n  'staff-photo-del':(id,b)=>{\n    const o=off(id);\n    api('staffPhoto',{id:id,photo:''},b).then(()=>{renderKeepStaff();toast('ລົບຮູບ '+full(o)+' ແລ້ວ');}).catch(e=>fail(e));\n  },\n  'st-ph-clear':()=>{\n    ui.newPhoto='';\n    const v=$('#st-ph-prev');if(v){v.innerHTML=ic('cam');v.classList.remove('has-ph');}\n    const c=$('#st-ph-clear');if(c)c.hidden=true;\n  },\n  'staff-add':(id,b)=>{\n    const rank=$('#st-rank').value.trim(),name=$('#st-name').value.trim(),phone=$('#st-phone').value.trim(),m=$('#st-msg');\n    if(!name||!phone){m.textContent='ກະລຸນາໃສ່ຊື່ ແລະ ເບີໂທ.';m.className='form-msg bad';return;}\n    api('staffAdd',{rank:rank,name:name,phone:phone,photo:ui.newPhoto||''},b).then(()=>{ui.newPhoto='';render();toast('ເພີ່ມ '+(rank?rank+' ':'')+name+' ແລ້ວ');}).catch(e=>fail(e,m));\n  },\n  'settings-save':(id,b)=>{\n    const p=$('#set-phone').value.trim(),pw=$('#set-pass').value,m=$('#set-msg');\n    if(pw&&pw.length<4){m.textContent='ລະຫັດຕ້ອງມີຢ່າງໜ້ອຍ 4 ຕົວ.';m.className='form-msg bad';return;}\n    api('settingsSave',{unitPhone:p,pass:pw||''},b).then(()=>{render();toast(pw?'ບັນທຶກແລ້ວ · ປ່ຽນລະຫັດ admin ແລ້ວ':'ບັນທຶກການຕັ້ງຄ່າແລ້ວ');}).catch(e=>fail(e,m));\n  }\n};\ndocument.addEventListener('click',e=>{\n  if(e.target.id==='modal'){closeModal();return;}\n  if(e.target.id==='xmodal'){$('#xmodal').hidden=true;return;}\n  const b=e.target.closest('[data-act]');if(!b)return;\n  const f=H[b.dataset.act];if(f)f(b.dataset.id,b);\n});\ndocument.addEventListener('keydown',e=>{\n  if(e.key==='Escape'){if(!$('#xmodal').hidden){$('#xmodal').hidden=true;return;}if(!$('#modal').hidden)closeModal();}\n  if(e.key==='Enter'&&e.target.matches&&e.target.matches('tr.click'))openDetail(e.target.dataset.id);\n});\n\n/* live clock on the today card */\nsetInterval(()=>{const c=document.getElementById('att-clock');if(c)c.textContent=clockText();},1000);\n\n/* ---------- paper form ---------- */\nfunction paperHTML(r,interactive){\n  const o=off(r.officerId),dec=r.decision;\n  let stamp='';\n  if(dec)stamp=dec.result==='approved'?'<div class=\"stamp ok\">ອະນຸມັດ</div>':(dec.result==='rejected'?'<div class=\"stamp no\">ບໍ່ອະນຸມັດ</div>':'<div class=\"stamp no\">ຂາດ</div>');\n  const row=(k,v)=>'<dt>'+k+'</dt><dd>'+v+'</dd>';\n  const attach=[r.attachMed?'ໃບຢັ້ງຢືນແພດ':'',r.attachOrder?'ຄຳສັ່ງ ປກສ':''].filter(Boolean).join(', ')||'ບໍ່ມີ';\n  let decHTML;\n  if(dec)decHTML='<div class=\"decision\">'+stamp+'<p class=\"muted\" style=\"font-size:13px\">ຄຳເຫັນຂອງຫົວໜ້າໜ່ວຍບໍລິການ</p><p>'+esc(dec.comment)+'</p><p class=\"muted\" style=\"font-size:13px\">'+esc(dec.by)+' · '+fDT(dec.at)+'</p></div>';\n  else if(r.status==='phone')decHTML='<div class=\"decision\"><p>ແຈ້ງທາງໂທລະສັບ ເວລາ '+esc(r.callTime)+' ຫາ '+esc(r.phoneLog.by)+'. ລໍຖ້າໃບລາຍ້ອນຫຼັງ.</p><p>'+dueText(r)+'</p></div>';\n  else decHTML='<div class=\"decision\"><p class=\"muted\">ລໍຖ້າຫົວໜ້າໜ່ວຍບໍລິການອະນຸມັດ</p></div>';\n  const by=r.returnBy==='self'?'ຕົນເອງ (ກົດໃນລະບົບ)':(r.returnBy==='head'?'ຫົວໜ້າໜ່ວຍບໍລິການ':'—');\n  const selfret=interactive&&canSelfReturn(r)?'<div class=\"selfret\"><p>ກຳນົດກັບ: <b>'+fDate(expRet(r))+'</b>. ເມື່ອກັບຮອດຫ້ອງການແລ້ວ ກົດ \"ກັບຄືນ\" ລະບົບຈະບັນທຶກເວລາປັດຈຸບັນເປັນເວລາກັບ ແລະ ແຈ້ງຫົວໜ້າໜ່ວຍບໍລິການ.</p><div><button class=\"btn primary\" type=\"button\" data-act=\"self-return\" data-id=\"'+r.id+'\">ກັບຄືນ</button></div></div>':'';\n  return '<div class=\"paper\">'+\n    '<p class=\"motto\"><b>ສາທາລະນະລັດ ປະຊາທິປະໄຕ ປະຊາຊົນລາວ</b><br>ສັນຕິພາບ ເອກະລາດ ປະຊາທິປະໄຕ ເອກະພາບ ວັດທະນະຖາວອນ</p>'+\n    '<div class=\"paper-meta\"><span>ທະນາຄານພັດທະນາລາວ<br>ໜ່ວຍບໍລິການ ເມືອງຄອບ</span><span>ເລກທີ: <b class=\"no\" style=\"color:var(--fg)\">'+(r.no||'……/ລພ.ໜບຄ')+'</b><br>ວັນທີຍື່ນ: '+(r.submittedAt?fDT(r.submittedAt):'—')+'</span></div>'+\n    '<h3 class=\"paper-title\">ໃບຂໍລາພັກ ຕຳຫຼວດປະຈຳການ</h3><p class=\"to\">ຮຽນ: ຫົວໜ້າໜ່ວຍບໍລິການ ເມືອງຄອບ</p>'+\n    '<p class=\"sect\">ກ. ຜູ້ຂໍລາພັກ</p><dl class=\"pkv\">'+row('ຍົດ, ຊື່ ແລະ ນາມສະກຸນ',esc(full(o)))+row('ເບີໂທ',esc(o.phone||'—'))+row('ໜ່ວຍງານຕົ້ນສັງກັດ','ປກສ ເມືອງຄອບ')+'</dl>'+\n    '<p class=\"sect\">ຂ. ລາຍລະອຽດການລາ</p><dl class=\"pkv\">'+row('ປະເພດ','<b>'+r.type+'</b> '+TYPES[r.type].label)+row('ໄລຍະເວລາ',esc(period(r))+' · '+qtyText(r))+row('ເຫດຜົນ',esc(reasonText(r))+(r.orderNo?' · ຄຳສັ່ງເລກທີ '+esc(r.orderNo):''))+row('ລາຍລະອຽດ',esc(r.detail||'—'))+row('ສະຖານທີ່ທີ່ຈະໄປ',esc(r.destination||'—'))+row('ເບີຕິດຕໍ່ໃນເວລາລາ',esc(r.phone||'—'))+row('ຕິດຕໍ່ສຸກເສີນ',r.emergencyPhone?esc(r.emergencyName)+' · '+esc(r.emergencyPhone):'—')+row('ເອກະສານຕິດຄັດ',attach)+row('ການຍື່ນ',r.filing==='retro'?'ຍ້ອນຫຼັງ (ສຸກເສີນ) · ໂທແຈ້ງ '+esc(r.callTo)+' ເວລາ '+esc(r.callTime):'ລ່ວງໜ້າ')+'</dl>'+\n    '<p class=\"sect\">ຄ. ການມອບໜ້າທີ່</p><dl class=\"pkv\">'+row('ຜູ້ຮັບມອບ / ຜູ້ແທນ',esc(coverName(r)))+(TYPES[r.type].pks?row('ແຈ້ງ ປກສ',r.pksNotified?'ແຈ້ງແລ້ວ'+(r.pksContact?' · '+esc(r.pksContact):''):'ຍັງບໍ່ແຈ້ງ'):'')+'</dl>'+\n    '<p class=\"sect\">ງ. ການອະນຸມັດ</p>'+decHTML+\n    '<p class=\"sect\">ຈ. ລາຍງານກັບຄືນ</p><dl class=\"pkv\">'+row('ກັບມາປະຈຳການ',r.returnedAt?fDT(r.returnedAt):'—')+row('ກັບຊ້າກວ່າກຳນົດ',r.returnedAt?(r.late>0.01?'ແມ່ນ · '+fmtH(r.late):'ບໍ່'):'—')+row('ບັນທຶກໂດຍ',by)+(r.returnBy==='self'?row('ຫົວໜ້າຮັບຊາບ',r.returnAck===false?'ລໍຖ້າຮັບຊາບ':'ຮັບຊາບແລ້ວ'+(r.returnAckAt?' · '+fDT(r.returnAckAt):'')):'')+'</dl>'+selfret+\n    '</div>';\n}\nfunction openDetail(id,note){\n  const r=get(id);if(!r)return;\n  $('#modal-body').innerHTML='<div class=\"mtool\">'+(note?'<span class=\"mnote\">'+esc(note)+'</span>':'<span class=\"no\">'+(r.no||'ແຈ້ງທາງໂທ')+'</span>')+\n    '<button class=\"btn primary sm\" type=\"button\" data-act=\"export-leave\" data-id=\"'+r.id+'\">ສົ່ງອອກເປັນຮູບພາບ</button></div>'+paperHTML(r,true);\n  const m=$('#modal');m.hidden=false;m.scrollTop=0;$('#modal .close').focus();\n}\nfunction closeModal(){$('#modal').hidden=true;}\n\n/* ---------- export to image ---------- */\nlet X=null;\nasync function exportImage(inner,filename,width,btn){\n  if(!window.html2canvas){toast('ໂຫຼດເຄື່ອງມືສ້າງຮູບບໍ່ໄດ້ ກວດອິນເຕີເນັດແລ້ວລອງໃໝ່');return;}\n  if(btn){btn.disabled=true;}\n  toast('ກຳລັງສ້າງຮູບ…');\n  const host=document.createElement('div');\n  host.className='exp';host.id='exp-host';host.style.width=width+'px';\n  host.innerHTML=inner+'<p class=\"exp-foot\" style=\"padding:0 34px 18px\">ສົ່ງອອກຈາກ ລະບົບຂໍລາ ຕຳຫຼວດປະຈຳການ · '+fDT(nowL())+'</p>';\n  document.body.appendChild(host);\n  try{\n    if(document.fonts&&document.fonts.ready)await document.fonts.ready;\n    const canvas=await window.html2canvas(host,{scale:2,backgroundColor:'#ffffff',logging:false,windowWidth:width+40,\n      onclone:doc=>{const h=doc.getElementById('exp-host');if(h){h.style.left='0px';}}});\n    const url=canvas.toDataURL('image/png');\n    const blob=await new Promise(res=>canvas.toBlob(res,'image/png'));\n    showExport(url,blob,filename);\n  }catch(e){toast('ສ້າງຮູບບໍ່ສຳເລັດ ລອງໃໝ່ອີກຄັ້ງ');}\n  finally{host.remove();if(btn)btn.disabled=false;}\n}\nfunction showExport(url,blob,filename){\n  X={blob:blob,filename:filename};\n  $('#xbody').innerHTML='<div class=\"xbox\"><div style=\"padding-right:44px\"><b>ຮູບພາບພ້ອມແລ້ວ</b><p class=\"how\">ບັນທຶກ ຫຼື ສຳເນົາ ແລ້ວສົ່ງໃນກຸ່ມແຊັດ ເພື່ອແຈ້ງໃຫ້ຮັບຊາບ.</p></div>'+\n    '<div class=\"actions\">'+'<button class=\"btn primary\" type=\"button\" data-act=\"x-save\">ບັນທຶກຮູບ</button>'+'<button class=\"btn ghost\" type=\"button\" data-act=\"x-copy\">ສຳເນົາຮູບ</button></div>'+\n    '<p class=\"how\">ຖ້າປຸ່ມໃຊ້ບໍ່ໄດ້ໃນເຄື່ອງນີ້: ກົດຄ້າງທີ່ຮູບ (ໂທລະສັບ) ຫຼື ຄລິກຂວາ (ຄອມ) ແລ້ວເລືອກ ບັນທຶກຮູບ / ສຳເນົາຮູບ.</p>'+\n    '<img class=\"ximg\" src=\"'+url+'\" alt=\"'+esc(filename)+'\"></div>';\n  const m=$('#xmodal');m.hidden=false;m.scrollTop=0;$('#xmodal .close').focus();\n  toast('ສ້າງຮູບແລ້ວ');\n}\nfunction leaveFile(r){return 'ໃບລາ-'+(r.no?r.no.split('/')[0]:'ແຈ້ງທາງໂທ')+'-'+r.startDate+'.png';}\nfunction regExportHTML(ym){\n  const d=registerData(ym);\n  return '<div class=\"exp-pad\"><p class=\"exp-org\">ທະນາຄານພັດທະນາລາວ · ໜ່ວຍບໍລິການ ເມືອງຄອບ</p><h2 class=\"exp-title\">ທະບຽນການລາ ຕຳຫຼວດປະຈຳການ</h2><p class=\"exp-month\">ເດືອນ'+monthLabel(ym)+'</p>'+\n    '<h3 class=\"sec\">ສັງລວມທ້າຍເດືອນ</h3>'+summaryTable(d.sum)+'<p class=\"foot\">'+RULE_NOTE+'</p>'+\n    '<h3 class=\"sec\">ລາຍການໃບລາ ('+d.inM.length+')</h3>'+(d.inM.length?recordsTable(d.inM,false):empty('ບໍ່ມີໃບລາໃນເດືອນນີ້'))+\n    '<div class=\"exp-sign\"><div>ຜູ້ສັງລວມ<br><br><br>(..............................)</div><div>ຫົວໜ້າໜ່ວຍບໍລິການ ເມືອງຄອບ<br><br><br>(..............................)</div></div></div>';\n}\n\n/* ---------- toast ---------- */\nlet toastT=0;\nfunction toast(t){const el=$('#toast');el.textContent=t;el.hidden=false;clearTimeout(toastT);toastT=setTimeout(()=>{el.hidden=true;},2800);}\n\nfunction onField(e){\n  const el=e.target;\n  if(el.id==='me-sel'){if(e.type!=='change')return;state.me=el.value;draft=newDraft();save();render();return;}\n  if(el.id==='reg-month'){if(e.type!=='change')return;ui.month=el.value;render();return;}\n  if(el.id==='pf-t'){const x=$('.pf-time');if(x)x.hidden=el.value!=='ອຊ';return;}\n  if(el.id&&el.id.indexOf('cm-')===0){const u=pendUI[el.id.slice(3)]=pendUI[el.id.slice(3)]||{};u.comment=el.value;u.arm=null;return;}\n  if(el.id&&el.id.indexOf('by-')===0){const u=pendUI[el.id.slice(3)]=pendUI[el.id.slice(3)]||{};u.by=el.value;return;}\n  if(!el.closest||!el.closest('#lf')||!el.name)return;\n  const n=el.name;\n  if(el.type==='checkbox')draft[n]=el.checked;\n  else if(el.type==='radio'){if(!el.checked)return;draft[n]=el.value;}\n  else draft[n]=el.value;\n  if(n==='type'){\n    const t=TYPES[draft.type];\n    if(draft.type==='ໜທ'){draft.reason='ວຽກ ປກສ';const rr=document.querySelector('#lf input[name=\"reason\"][value=\"ວຽກ ປກສ\"]');if(rr)rr.checked=true;}\n    if(t.kind==='range'&&diffDays(draft.startDate,draft.endDate)<(draft.type==='ລ4'?1:0)){draft.endDate=addDays(draft.startDate,draft.type==='ລ4'?1:0);$('#f-end').value=draft.endDate;}\n  }\n  if(n==='startDate'&&TYPES[draft.type].kind==='range'&&draft.endDate<draft.startDate){draft.endDate=draft.startDate;$('#f-end').value=draft.endDate;}\n  $('#f-msg').textContent='';\n  dyn();\n}\ndocument.addEventListener('input',onField);\ndocument.addEventListener('change',onField);\ndocument.addEventListener('submit',e=>{\n  if(e.target.id==='login'){\n    e.preventDefault();\n    const p=$('#lg-pass'),m=$('#lg-msg'),b=e.target.querySelector('button[type=\"submit\"]');\n    api('login',{pass:p.value},b).then(()=>{state.tab.head=state.tab.head||'home';render();toast('ເຂົ້າສູ່ລະບົບແລ້ວ');}).catch(err=>{m.textContent=err.message;m.className='form-msg bad';p.select();});\n    return;\n  }\n  if(e.target.id!=='lf')return;\n  e.preventDefault();\n  const r=draftRec(),bad=checks(r).filter(c=>c.lv==='bad'),msg=$('#f-msg');\n  if(bad.length){msg.textContent='ຍັງສົ່ງບໍ່ໄດ້: ແກ້ໄຂ '+bad.length+' ຂໍ້ທີ່ໝາຍ ✕ ກ່ອນ.';msg.className='form-msg bad';$('#f-checks').scrollIntoView({block:'center'});return;}\n  if(!draft.pledge){msg.textContent='ກະລຸນາໝາຍຢັ້ງຢືນຂໍ້ມູນກ່ອນສົ່ງ.';msg.className='form-msg bad';return;}\n  const btn=$('#f-submit');\n  api('submit',{rec:r,linkId:draft.linkId||null},btn).then(res=>{\n    draft=newDraft();state.tab.officer='mine';save();render();window.scrollTo(0,0);\n    const rec=get(res.id);\n    openDetail(res.id,'ສົ່ງໃບລາ '+(rec?rec.no:'')+' ແລ້ວ · ສົ່ງອອກເປັນຮູບເພື່ອແຈ້ງໃນກຸ່ມ');\n  }).catch(err=>fail(err,msg));\n});\n\n$('#today').textContent='ວັນ'+wd(today())+' '+fD(today());\nrender();\nrefresh(true);\n/* keep data fresh: reload when the tab comes back, and every 2 minutes when idle on a non-form view */\ndocument.addEventListener('visibilitychange',()=>{if(!document.hidden&&ui.loaded)refresh(true);});\nsetInterval(()=>{if(document.hidden||!ui.loaded||ui.busy)return;const cur=state.tab[state.role];if(cur==='new'||cur==='approve'||cur==='staff'||!$('#modal').hidden)return;refresh(true);},120000);\n\n})();\n<\/script>\n</body>\n</html>\n";
