ຄ່ຳ: ຕ້ອງກັບມາປະຈຳການ 18:00'});\n  out.push(t.deduct?{lv:'info',tx:'ບໍ່ໄດ້ອັດຕາກິນ '+qty(r)+' ມື້ (−'+money(qty(r)*RATE)+')'}:{lv:'info',tx:'ບໍ່ຫັກອັດຕາກິນ (ຍັງໄດ້ 50,000 ກີບ/ມື້)'});\n  return out;\n}\nconst checksHTML=list=>list.map(c=>'<li class=\"'+c.lv+'\">'+esc(c.tx)+'</li>').join('');\n\nfunction approveText(r){\n  const t=TYPES[r.type];\n  const verb={'ອຊ':'ອອກນອກຈຸດປະຈຳການຊົ່ວຄາວ','ລ1':'ລາເຄິ່ງມື້ຊ່ວງເຊົ້າ','ລ2':'ລາເຄິ່ງມື້ຊ່ວງບ່າຍ','ລ3':'ລາໝົດມື້','ລ4':'ລາພັກ '+qty(r)+' ມື້','ໜທ':'ໄປປະຕິບັດໜ້າທີ່ຕາມຄຳສັ່ງ ປກສ ເລກທີ '+(r.orderNo||'…')}[r.type];\n  let back;\n  if(t.kind==='time')back='ໃຫ້ກັບມາກ່ອນເວລາ '+r.timeTo+'.';\n  else if(r.type==='ລ1')back='ໃຫ້ກັບມາປະຈຳການ 12:30 ແລະ ພາກຄ່ຳ 18:00.';\n  else if(r.type==='ລ2')back='ໃຫ້ກັບມາປະຈຳການພາກຄ່ຳ 18:00.';\n  else back='ໃຫ້ກັບມາປະຈຳການ ວັນທີ '+fD(addDays(r.endDate||r.startDate,1))+' ເວລາ 08:30.';\n  const pre=r.filing==='retro'?'ອະນຸມັດທາງໂທລະສັບ ເວລາ '+r.callTime+'. ':'';\n  return pre+'ເຫັນດີອະນຸມັດ ໃຫ້ '+full(off(r.officerId))+' '+verb+' '+period(r)+'. ມອບໃຫ້ '+coverName(r)+' ປະຈຳການແທນ. '+back;\n}\n\n/* ---------- demo data (used only when the page is opened outside Google Apps Script) ---------- */\nfunction seedDemo(){\n  const T=today(),now=new Date();\n  const officers=[\n    {id:'o1',rank:'ສທ',name:'ຈັນທະການ ຄຳວິພາ',phone:'020 9970 8556',active:true},\n    {id:'o2',rank:'ພັຕ',name:'ແກ້ວ ວົງສາ',phone:'020 9538 7448',active:true}\n  ];\n  const store={officers:officers,settings:{unitPhone:'020 5555 0000'},seq:{},records:[]};\n  const base={reasonOther:'',orderNo:'',detail:'',attachMed:false,attachOrder:false,filing:'advance',callTime:'',callTo:'',pksReplacement:'',pksNotified:false,pksContact:'',decision:null,returnedAt:'',returnBy:'',late:0,timeFrom:'',timeTo:'',no:''};\n  const E={o1:{emergencyName:'ພັນລະຍາ (ຕົວຢ່າງ)',emergencyPhone:'020 1111 2222'},o2:{emergencyName:'ພໍ່ (ຕົວຢ່າງ)',emergencyPhone:'020 3333 4444'}};\n  const S=(o,x)=>Object.assign({id:lvUid_()+Math.random().toString(36).slice(2,5),officer